# Display Seira Alarm as normal text in English
# First line
@@ CHLCC_AA02.scs
	CallFar 6, @ignore
	MessWindowCloseEx 0
	MessWindowClosedWait
-   $W(3172) = 40;
+   $W(3172) = 0;
    AutoSaveSetSavePoint
    AutoSave_14
    SetSavePointMain
    SetFlag 1288
-   SetFlag 1205

